# ---------------------------------------------------------------------------
# Family Roots - PRODUCTION environment template
#
# Copy to `.env` in the project root (never inside public/) and edit:
#     cp deploy/.env.production.example .env
#     chmod 600 .env
#
# The installer (`php database/install.php`) writes a development-oriented
# `.env` from `.env.example`; review every value below against the generated
# file before going live. See DEPLOYMENT.md.
#
# Real OS environment variables override these values.
# ---------------------------------------------------------------------------

APP_NAME="Family Roots"
# "production" also hides the demo-account hint on the login page.
APP_ENV=production
# MUST be false in production: debug pages expose internals.
APP_DEBUG=false
# 1 = clean URLs; requires mod_rewrite (see deploy/apache-family-roots.conf).
APP_PRETTY_URLS=1
# Currently unused by the code (URLs come from the request). Harmless.
APP_URL=https://family-roots.example.com
APP_TIMEZONE=UTC
# Reserved; not used by current code. Set 32+ random bytes anyway.
APP_KEY=

# --- Database --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=family_roots
# Least-privilege account created by the installer. Never root.
DB_USER=family_roots_app
DB_PASS=
# Seconds to wait for the initial connection (queries are not limited by this).
DB_TIMEOUT=5
# Log statements slower than this (ms) with their route; never the bind values.
DB_SLOW_QUERY_MS=500
# Row-lock wait ceiling, kept below PHP's own execution limit.
DB_LOCK_WAIT_TIMEOUT=20

# --- Session ---------------------------------------------------------------
SESSION_NAME=family_roots_session
SESSION_LIFETIME=7200
# 1 = HTTPS only. Required in production.
SESSION_SECURE=1
SESSION_SAMESITE=Lax

# --- Mail ------------------------------------------------------------------
# log = write to storage/logs/mail-*.log (no email delivered)
# mail = PHP mail(); requires a local MTA/relay on the host.
# There is no SMTP client in this application.
MAIL_TRANSPORT=mail
MAIL_FROM="Family Roots <no-reply@example.com>"

# --- Rate limiting ---------------------------------------------------------
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_SECONDS=900

# --- Audit -----------------------------------------------------------------
# Membership, verification, correction and account events -> audit_logs.
AUDIT_ENABLED=true
