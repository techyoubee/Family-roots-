# ---------------------------------------------------------------------------
# Family Roots - environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
# The CLI installer (`php database/install.php --db-pass=...`) can generate
# this file for you, including a random APP_KEY and a least-privilege DB user.
# ---------------------------------------------------------------------------

APP_NAME="Family Roots"
APP_ENV=local
# true only on a developer machine. MUST be false in production.
APP_DEBUG=true
# 1 = clean URLs (/login) and requires mod_rewrite + AllowOverride on the vhost.
# 0 = fallback links (index.php?r=/login) that work on default XAMPP/AppServ.
APP_PRETTY_URLS=0
# Leave blank to auto-detect from the request. Set explicitly in production,
# e.g. https://family-roots.example.com  (no trailing slash).
APP_URL=
APP_TIMEZONE=UTC
# 32+ random bytes, base64 or hex. The installer generates one for you.
APP_KEY=

# --- Database --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=family_roots
# Least-privilege account that can only touch DB_NAME. Never use root here.
DB_USER=family_roots_app
DB_PASS=
# Seconds to wait for the initial connection only (not for queries).
DB_TIMEOUT=5
# Statements slower than this are logged with their route so stalls are
# traceable. 500 ms is far above normal on localhost.
DB_SLOW_QUERY_MS=500
# InnoDB row-lock wait ceiling, in seconds. Kept below PHP's 30 s limit so a
# stuck request fails with a log entry instead of a fatal error.
DB_LOCK_WAIT_TIMEOUT=20

# --- Session ---------------------------------------------------------------
SESSION_NAME=family_roots_session
SESSION_LIFETIME=7200
# Set to 1 when serving over HTTPS so cookies are not sent in the clear.
SESSION_SECURE=0
SESSION_SAMESITE=Lax

# --- Mail ------------------------------------------------------------------
# log = write messages to storage/logs/mail-*.log (safe default for XAMPP)
# mail = hand to PHP's mail() function (needs a configured MTA)
MAIL_TRANSPORT=log
MAIL_FROM="Family Roots <no-reply@family-roots.local>"

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
UPLOAD_DIR=

# --- Rate limiting ---------------------------------------------------------
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_SECONDS=900
